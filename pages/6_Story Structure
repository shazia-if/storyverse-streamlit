import streamlit as st

from database import Session
from models import Story
from models import Chapter
from models import Scene
from models import ReaderOrder

db= Session()

if "current_story_id" not in st.session_state:
    st.warning(
        "Please select a story first from the Stories page."
    )
    st.stop()
else:
    st.info(
        f"📖 Current Story: "
        f"{st.session_state['current_story_title']}"
    )



#Getting the data

#story_id = db.query(Story).where(Story.id== st.session_state["current_story_id"])
story_id = st.session_state["current_story_id"]

chapters = (
    db.query(Chapter)
    .filter(Chapter.story_id == story_id)
    .order_by(Chapter.chapter_number)
    .all()
)

scenes = (
    db.query(Scene)
    .filter(Scene.story_id == story_id)
    .all()
)




st.title("Story Structure")
for chap in chapters:
    with st.expander(f"📖 Chapter {chap.chapter_number}:{chap.chapter_title}", 
                     ):
        
        if chap.chapter_summary:
            st.write(chap.chapter_summary)
        
        st.divider()
        st.caption("Scenes")

        chapter_scenes = (
        db.query(ReaderOrder)
        .filter(ReaderOrder.chapter_id == chap.id)
        .order_by(ReaderOrder.position)
        .all()
                )

        if chapter_scenes:
            for order in chapter_scenes:

                scene = db.get(Scene, order.scene_id)

                with st.expander(f"🎬 {scene.title}"):

                    st.write(f"Scene Title: {scene.title}")

                    if scene.summary:
                        st.write(f"Summary: {scene.summary}")

                    col1, col2, col3, col4 = st.columns([6, 1, 1, 2])

                    with col1:
                        st.write(f"Position: {order.position}")

                    with col2:
                        if st.button(
                            "⬆️",
                            key=f"up_{order.id}"
                        ):
                            if order.position > 1:

                                previous = (
                                    db.query(ReaderOrder)
                                    .filter(
                                        ReaderOrder.chapter_id == chap.id,
                                        ReaderOrder.position == order.position - 1
                                    )
                                    .first()
                                )

                                if previous:
                                    current_position = order.position
                                    previous_position = previous.position

                                    order.position = 0
                                    db.flush()

                                    previous.position = current_position
                                    order.position = previous_position

                                    db.commit()
                                    st.rerun()

                    with col3:
                        if st.button(
                            "⬇️",
                            key=f"down_{order.id}"
                        ):
                            next_scene = (
                                db.query(ReaderOrder)
                                .filter(
                                    ReaderOrder.chapter_id == chap.id,
                                    ReaderOrder.position == order.position + 1
                                )
                                .first()
                            )

                            if next_scene:

                                current_position = order.position
                                next_position = next_scene.position

                                order.position = 0
                                db.flush()

                                next_scene.position = current_position
                                order.position = next_position

                                db.commit()
                                st.rerun()

                    with col4:
                        if st.button(
                            "↩️ Remove",
                            key=f"remove_{scene.id}"
                        ):
                            scene.chapter_id = None

                            removed_position = order.position

                            db.delete(order)
                            db.flush()

                            following_scenes = (
                            db.query(ReaderOrder)
                                        .filter(
                                            ReaderOrder.chapter_id == chap.id,
                                            ReaderOrder.position > removed_position
                                        )
                                        .all()
                                    )

                            for following in following_scenes:
                                    following.position -= 1

                            db.commit()
                            st.rerun()



                    if st.button(
                        "🎬 Go to Scene",
                        key=f"go_scene_{scene.id}"
                    ):
                        st.session_state["target_scene_id"] = scene.id
                        st.switch_page("pages/5_Scenes.py")

        else:
            st.info("No scenes assigned.")


unassigned = (
    db.query(Scene)
    .filter(
        Scene.story_id == st.session_state["current_story_id"],
        Scene.chapter_id == None
    )
    .all()
)

st.subheader("📦 Unassigned Scenes")

if unassigned:

    chapter_choices = {
    f"Chapter {c.chapter_number}: {c.chapter_title}": c.id
    for c in chapters}

    for scene in unassigned:
        with st.expander(f"🎬 {scene.title}"):
                    if scene.summary:
                        st.write(scene.summary)

        selected = st.selectbox(
            "Assign to chapter",
            chapter_choices.keys(),
            key=f"assign_{scene.id}"
        )

        if st.button(
            "Assign",
            key=f"btn_{scene.id}"
        ):
            selected_id= chapter_choices[selected]
            scene.chapter_id = selected_id
            #scene.chapter_id = chapter_choices[selected]

            
            last_position = (
                db.query(ReaderOrder)
                .filter(
                    ReaderOrder.chapter_id == selected_id
                )
                .count()
            )

            reader = ReaderOrder(
                chapter_id=selected_id,
                scene_id=scene.id,
                position=last_position + 1
            )

            db.add(reader)

           

            

            db.commit()
            st.rerun()
else:
    st.success("All scenes have been assigned!")
    
    



